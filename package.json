{
  "name": "fidget-box",
  "version": "1.0.0",
  "private": true,
  "description": "Ad-free fidget toys as an offline-first PWA.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node build.mjs",
    "start": "node server.mjs",
    "dev": "node server.mjs --dev",
    "icons": "node scripts/make-icons.mjs",
    "verify": "node build.mjs && node scripts/verify.mjs"
  }
}
